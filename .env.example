# Google OAuth (create these in Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Gemini API key (aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Where the local JSON "brain" store lives (used only when Redis isn't configured)
BRAIN_DATA_DIR=./data

# Optional: Upstash Redis for persistent storage on serverless deploys
# (e.g. Vercel). Not needed for local dev — the app falls back to the
# local JSON store above when these are unset. Get these by creating an
# Upstash Redis database from Vercel's Storage tab and connecting it to
# your project (it fills these in automatically).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
